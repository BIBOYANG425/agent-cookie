{
  "name": "agent-cookie",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "fake": "pnpm --filter @agent-cookie/workspace-fake start",
    "workspace": "pnpm --filter @agent-cookie/workspace start",
    "demo:reset": "curl -s -X POST -H \"Authorization: Bearer $AGENT_COOKIE_KEY\" \"${AGENT_COOKIE_URL:-http://127.0.0.1:4310}/demo/reset\""
  }
}
