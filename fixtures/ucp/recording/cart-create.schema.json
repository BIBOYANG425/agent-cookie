            "items": {
              "type": "object",
              "required": [
                "type",
                "url"
              ],
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "The policy URL."
                }
              }
            }
          },
          "messages": {
            "type": "array",
            "description": "Errors or warnings surfaced while processing the tool call.",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "info"
                  ]
                },
                "content_type": {
                  "type": "string",
                  "enum": [
                    "plain",
                    "markdown"
                  ]
                },
                "code": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "recoverable",
                    "requires_buyer_input",
                    "requires_buyer_review",
                    "unrecoverable"
                  ]
                },
                "path": {
                  "type": "string"
                }
              }
            }
          },
          "continue_url": {
            "type": "string",
            "format": "uri",
            "description": "The URL where the buyer can continue checkout."
          },
          "fulfillment": {
            "type": "object",
            "description": "Fulfillment methods, destinations, delivery groups, and delivery options.",
            "additionalProperties": true,
            "properties": {
              "methods": {
                "type": "array",
                "description": "Fulfillment methods available for the checkout or cart.",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "type",
                    "line_item_ids"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "shipping",
                        "pickup"
                      ]
                    },
                    "line_item_ids": {
                      "type": "array",
                      "description": "Line item IDs covered by this fulfillment method.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "selected_destination_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "destinations": {
                      "type": "array",
                      "description": "Destinations available for this fulfillment method.",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "first_name": {
                            "type": "string"
                          },
                          "last_name": {
                            "type": "string"
                          },
                          "phone_number": {
                            "type": "string"
                          },
                          "street_address": {
                            "type": "string"
                          },
                          "extended_address": {
                            "type": "string"
                          },
                          "address_locality": {
                            "type": "string"
                          },
                          "address_region": {
                            "type": "string"
                          },
                          "postal_code": {
                            "type": "string"
                          },
                          "address_country": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "groups": {
                      "type": "array",
