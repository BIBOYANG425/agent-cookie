                      ]
                    },
                    "path": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "title": "Error response",
            "description": "The tool could not return its resource; `messages` explains why.",
            "required": [
              "ucp",
              "messages"
            ],
            "additionalProperties": true,
            "properties": {
              "ucp": {
                "type": "object",
                "required": [
                  "status"
                ],
                "additionalProperties": true,
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "error"
                    ]
                  }
                }
              },
              "messages": {
                "type": "array",
                "description": "Errors or warnings surfaced while processing the tool call.",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning",
                        "info"
                      ]
                    },
                    "content_type": {
                      "type": "string",
                      "enum": [
                        "plain",
                        "markdown"
                      ]
                    },
                    "code": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "recoverable",
                        "requires_buyer_input",
                        "requires_buyer_review",
                        "unrecoverable"
                      ]
                    },
                    "path": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
