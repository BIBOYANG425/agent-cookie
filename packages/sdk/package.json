{
  "name": "@agent-cookie/sdk",
  "version": "0.1.0",
  "description": "Agent Cookie clients: a company assistant, a store's agent or the person's own agent knows the person on its first message, within their policy, with a receipt.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@agent-cookie/contract": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "2.1.9"
  }
}
