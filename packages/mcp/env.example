# Copy to .env locally; never commit the real key.
AGENT_COOKIE_URL=http://127.0.0.1:4310
AGENT_COOKIE_KEY=
# Enable for fixture/stub demos; remove for a verified live backend.
AGENT_COOKIE_SAMPLE=1
# MCP transport: stdio (default) or http (Streamable HTTP on 127.0.0.1:4311/mcp; keys come per request as bearer
# tokens, AGENT_COOKIE_KEY is then not read). MCP_HTTP_PORT overrides 4311.
# AGENT_COOKIE_MCP_TRANSPORT=http
# MCP_HTTP_PORT=4311
