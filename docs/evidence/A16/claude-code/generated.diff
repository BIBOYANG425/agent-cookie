+# Copyright 2026 Anthropic PBC
+# SPDX-License-Identifier: Apache-2.0
+
+"""Agent Cookie mode against a fake of the workspace's merchant routes: bindings, the
+per-turn authorization check, field reads, note writes through the deployment's filter,
+and the operations the contract lacks failing loudly."""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime
+
+import httpx
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from commerce_common.skills import SkillRegistry
+from demo_common.sessions import SessionStore
+from retail.api import agent_cookie as ac
+from retail.api.mock_retail import MockRetail
+from shopping_agent import (
+    PageContext,
+    ShoppingAgentConfig,
+    ShoppingSessionContext,
+    ShoppingSessionState,
+)
+from shopping_agent.executor import build_memory
+
+NOTE_KEYS = ("fit_notes", "gift_recipients")
+
+
+class FakeWorkspace:
+    """The merchant routes as apps/workspace answers them: a key names an agent, a pairwise
+    session belongs to one agent, notes are keyed by (agent, session, key), and every call
+    checks the grant first."""
+
+    def __init__(self) -> None:
+        self.keys = {"key-a": "ag_a", "key-b": "ag_b"}
+        self.owner = {"pw-a1": "ag_a", "pw-a2": "ag_a", "pw-b1": "ag_b"}
+        self.grants = dict.fromkeys(self.owner, "live")
+        self.card = {
+            "lang": "en",
+            "tone": "brief",
+            "length": "short",
+            "shoe_size": "42",
+            "budget": "120",
+            "shipping_address": "Sample address",
+        }
+        self.notes: dict[tuple[str, str, str], str] = {}
+        self.note_limit = 2048
+        self.requests: list[httpx.Request] = []
+        self.down = False
+
+    def transport(self) -> httpx.MockTransport:
+        return httpx.MockTransport(self.handle)
+
+    def handle(self, request: httpx.Request) -> httpx.Response:
+        self.requests.append(request)
+        if self.down:
+            raise httpx.ConnectTimeout("no answer", request=request)
+        agent = self.keys.get(request.headers.get("authorization", "").removeprefix("Bearer "))
+        if agent is None:
+            return _error("AUTH_REQUIRED", 401)
+        path = request.url.path
+        if path == "/me":
+            return httpx.Response(
+                200, json={"agentId": agent, "category": "shoe", "role": "merchant"}
+            )
+        session = request.url.params.get("sessionId", "")
+        if self.owner.get(session) != agent:
+            return _error("NOT_FOUND", 404)
+        if self.grants[session] != "live":
+            return _error(self.grants[session], 403)
+        if path == "/agent/handshake":
+            available = ["lang", "tone", "length", "shoe_size", "budget", "shipping_address"]
+            style = {name: self.card[name] for name in ("lang", "tone", "length")}
+            return httpx.Response(
+                200, json={"v": 1, "sessionId": session, **style, "available": available}
+            )
+        if path == "/agent/fields":
+            names = request.url.params["fields"].split(",")
+            if "shipping_address" in names:
+                return _error("PURPOSE_MISMATCH", 403)
+            return httpx.Response(200, json={"fields": {name: self.card[name] for name in names}})
+        key = path.removeprefix("/agent/notes/")
+        if request.method == "PUT":
+            value = json.loads(request.content)["value"]
+            mine = {k: v for (a, s, k), v in self.notes.items() if (a, s) == (agent, session)}
+            mine[key] = value
+            if len(json.dumps(list(mine.items())).encode()) > self.note_limit:
+                return _error("MISSING_FIELD", 422)
+            self.notes[(agent, session, key)] = value
+            return httpx.Response(200, json={"key": key, "updatedAt": "2026-10-17T12:00:00.000Z"})
+        if (agent, session, key) not in self.notes:
+            return _error("NOT_FOUND", 404)
+        value = self.notes[(agent, session, key)]
+        return httpx.Response(
+            200, json={"key": key, "value": value, "updatedAt": "2026-10-17T12:00:00.000Z"}
+        )
+
+    def calls(self, path_prefix: str) -> int:
+        return sum(1 for request in self.requests if request.url.path.startswith(path_prefix))
+
+
+def _error(code: str, status: int) -> httpx.Response:
+    return httpx.Response(status, json={"error": {"code": code, "message": code}})
+
