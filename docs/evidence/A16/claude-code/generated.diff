+@pytest.mark.parametrize("ended", ["GRANT_REVOKED", "GRANT_EXPIRED"])
+async def test_an_ended_grant_refuses_reads_and_writes_without_a_fallback(workspace, ended):
+    agent_cookie = await connected(workspace)
+    agent_cookie.bind("store-1", "pw-a1")
+    tools = executor(agent_cookie, "store-1")
+    saved = await tools.execute("save_memory", {"key": "fit_notes", "value": "runs narrow"})
+    assert not saved.is_error
+    workspace.grants["pw-a1"] = ended
+    with pytest.raises(ac.WorkspaceError) as refused:
+        await agent_cookie.field_values("store-1")
+    assert refused.value.code == ended
+    preferences = await tools.execute("get_preferences", {})
+    assert preferences.is_error and "42" not in preferences.result_text
+    recalled = await tools.execute("recall_memories", {"topic": "fit"})
+    assert recalled.is_error and ended in recalled.result_text
+    assert "runs narrow" not in recalled.result_text
+    saved = await tools.execute("save_memory", {"key": "fit_notes", "value": "wide toe box"})
+    assert saved.is_error and ended in saved.result_text
