+def host_with(workspace: FakeWorkspace, key: str = "key-a"):
+    """A storefront host's shape: an app with chat, memory, and reset routes behind the gate."""
+
+    class Host:
+        app = FastAPI()
+        sessions = SessionStore(ShoppingSessionState)
+
+    host = Host()
+    turns: list[str] = []
+
+    @host.app.post("/api/chat")
+    async def chat() -> dict:
+        turns.append("model ran")
+        return {"ok": True}
+
+    @host.app.api_route("/api/memory", methods=["GET", "PATCH", "DELETE"])
+    async def memory() -> dict:
+        raise AssertionError("memory routes must not reach a store")
+
+    @host.app.post("/api/reset")
+    async def reset(request: dict) -> dict:
+        return {"ok": True, "received": request}
+
+    client = ac.WorkspaceClient("http://workspace.test", key, transport=workspace.transport())
+    agent_cookie = ac.AgentCookie(client, note_keys=NOTE_KEYS)
+    ac.install(host, agent_cookie)
+    return host, agent_cookie, turns
+
+
+def test_binding_gate_and_refused_memory_routes(workspace):
+    host, agent_cookie, turns = host_with(workspace)
+    with TestClient(host.app) as client:
+        assert (
+            client.post("/api/agent-cookie/session", json={"session_id": "pw-b1"}).status_code
+            == 404
+        )
+        started = client.post("/api/agent-cookie/session", json={"session_id": "pw-a1"})
+        assert started.status_code == 200
+        body = started.json()
+        assert body["user_id"].startswith("agent-cookie-") and body["user_id"] != "demo-user"
+        assert "shoe_size" in body["available"] and "42" not in json.dumps(body)
+        headers = {"X-Session-Id": body["session_id"]}
+
+        assert client.post("/api/chat", headers=headers).status_code == 200
+        workspace.grants["pw-a1"] = "GRANT_REVOKED"
+        refused = client.post("/api/chat", headers=headers)
+        assert (refused.status_code, refused.json()["detail"]) == (403, "GRANT_REVOKED")
+        assert turns == ["model ran"]
+
+        for method in ("GET", "PATCH", "DELETE"):
+            assert client.request(method, "/api/memory", headers=headers).status_code == 501
+        assert client.post("/api/reset", json={"purge_memory": True}).status_code == 501
+        kept = client.post("/api/reset", json={"clear_memory": False})
+        assert kept.json() == {"ok": True, "received": {"clear_memory": False}}
+    assert agent_cookie.client._http.is_closed
+
