+++ b/examples/demo_common/tests/test_agent_cookie.py
@@ -0,0 +1,273 @@
+# SPDX-License-Identifier: Apache-2.0
+
+"""Agent Cookie adapter against a scripted workspace transport: subject binding, per-call
+authorization, refusals without local fallback, note encoding and the C11 refusal."""
+
+from __future__ import annotations
+
+import json
+
+import httpx
+import pytest
+
+from commerce_common.memory import MemoryWriteFilter, MemoryWriteRejected
+from commerce_common.types import MemoryCategory, MemoryFact
+from demo_common.agent_cookie import (
+    C11_MISSING,
+    AgentCookieAccess,
+    AgentCookieError,
+    AgentCookiePreferences,
+    AgentCookieSettings,
+    ContractUnavailable,
+    RelationshipNotes,
+    UnboundSubject,
+    build_memory_store,
+)
+from shopping_agent import UserPreferences
+from shopping_agent.types import ShoppingSessionContext
+
+KEY_A = "merchant-key-a"
+KEY_B = "merchant-key-b"
+
+
+class Workspace:
+    """Records every request; answers from per-(key, session) state like the real routes."""
+
+    def __init__(self) -> None:
+        self.requests: list[httpx.Request] = []
+        self.notes: dict[tuple[str, str, str], str] = {}
+        self.denied: dict[str, str] = {}
+        self.unreachable = False
+
+    def __call__(self, request: httpx.Request) -> httpx.Response:
+        self.requests.append(request)
+        if self.unreachable:
+            raise httpx.ConnectError("down", request=request)
+        key = request.headers["authorization"].removeprefix("Bearer ")
+        session = request.url.params["sessionId"]
+        if session in self.denied:
+            code = self.denied[session]
+            return httpx.Response(403, json={"error": {"code": code, "message": code}})
+        if not session.startswith("s"):
+            return httpx.Response(404, json={"error": {"code": "SESSION_NOT_FOUND"}})
+        path = request.url.path
+        if path == "/agent/handshake":
+            return httpx.Response(
+                200,
+                json={
+                    "sessionId": session,
+                    "available": ["shoe_size", "budget"],
+                    "lang": "en",
+                    "tone": "direct",
+                },
+            )
+        if path == "/agent/fields":
+            names = request.url.params["fields"].split(",")
+            values = {"shoe_size": f"9-{session}", "budget": "120"}
+            return httpx.Response(
+                200,
+                json={"sessionId": session, "purpose": "", "fields": {n: values[n] for n in names}},
+            )
+        note_key = path.removeprefix("/agent/notes/")
+        if request.method == "PUT":
+            self.notes[(key, session, note_key)] = json.loads(request.content)["value"]
+            return httpx.Response(200, json={"key": note_key, "updatedAt": "t", "expiresAt": "t"})
+        value = self.notes.get((key, session, note_key))
+        if value is None:
+            return httpx.Response(404, json={"error": {"code": "NOT_FOUND"}})
+        return httpx.Response(200, json={"key": note_key, "value": value})
+
+
+def settings(key: str = KEY_A, **over) -> AgentCookieSettings:
+    base = dict(
+        url="http://workspace.test",
+        merchant_key=key,
+        bindings={"alice": "salice01", "bob": "sbob0001", "ghost": "x0000000"},
+        note_keys=frozenset({"fit_history"}),
+        fields=("shoe_size", "budget", "deadline"),
+    )
+    return AgentCookieSettings(**(base | over))
+
+
+@pytest.fixture
+def workspace() -> Workspace:
+    return Workspace()
+
+
+def access_for(workspace: Workspace, key: str = KEY_A) -> AgentCookieAccess:
+    return AgentCookieAccess.connect(settings(key), transport=httpx.MockTransport(workspace))
+
+
+class Local:
+    async def get_preferences(self, session: ShoppingSessionContext) -> UserPreferences:
+        return UserPreferences(
+            user_id=session.user_id, display_name="Local", preferences={"shoe_size": "LOCAL"}
+        )
+
+
+class Backend(AgentCookiePreferences, Local):
+    pass
+
+
+def ctx(user: str) -> ShoppingSessionContext:
+    return ShoppingSessionContext(session_id="host-session", user_id=user)
+
+
+def fact(key: str = "fit_history", value: str = "runs half a size small") -> MemoryFact:
+    return MemoryFact(
+        key=key, value=value, category=MemoryCategory.CONTEXT, source_session_id="abc123"
+    )
+
+
+def test_settings_refuse_unsafe_configuration():
+    with pytest.raises(ValueError, match="AGENT_COOKIE_KEY"):
+        settings(merchant_key="")
+    with pytest.raises(ValueError, match="own pairwise session"):
+        settings(bindings={"alice": "s1111111", "bob": "s1111111"})
+    with pytest.raises(ValueError, match="note key"):
+        settings(note_keys=frozenset({"payment_method"}))
+    with pytest.raises(ValueError, match="card table"):
+        settings(fields=("password",))
+    assert KEY_A not in repr(settings())
+
+
+def test_tier2_refuses_at_startup_naming_every_missing_capability():
+    with pytest.raises(ContractUnavailable) as raised:
+        build_memory_store(settings())
+    for missing in C11_MISSING:
+        assert missing in str(raised.value)
+    with pytest.raises(ContractUnavailable):
+        AgentCookieAccess.connect(settings(memory="tier2"))
+
+
+async def test_bound_subject_preferences_come_from_the_workspace(workspace):
+    backend = Backend()
+    backend.agent_cookie = access_for(workspace)
+    prefs = await backend.get_preferences(ctx("alice"))
+    assert prefs.display_name == "Local"
+    assert prefs.preferences == {
+        "lang": "en",
+        "tone": "direct",
+        "shoe_size": "9-salice01",
+        "budget": "120",
+    }
+    fields = workspace.requests[-1]
+    assert fields.url.params["fields"] == "shoe_size,budget"  # deadline not available
+    assert "purpose" not in fields.url.params
+    assert fields.headers["authorization"] == f"Bearer {KEY_A}"
+
+
+async def test_unbound_subject_keeps_local_profile_without_calling_the_workspace(workspace):
+    backend = Backend()
+    backend.agent_cookie = access_for(workspace)
+    prefs = await backend.get_preferences(ctx("demo-user"))
+    assert prefs.preferences == {"shoe_size": "LOCAL"}
+    assert workspace.requests == []
+    with pytest.raises(UnboundSubject):
+        await backend.agent_cookie.authorize("demo-user")
+
+
+async def test_every_call_reauthorizes_and_revocation_never_falls_back(workspace):
+    backend = Backend()
+    backend.agent_cookie = access_for(workspace)
+    await backend.get_preferences(ctx("alice"))
+    await backend.get_preferences(ctx("alice"))
+    assert [r.url.path for r in workspace.requests].count("/agent/handshake") == 2
+    for code in ("GRANT_REVOKED", "SESSION_EXPIRED"):
+        workspace.denied["salice01"] = code
+        with pytest.raises(AgentCookieError) as raised:
+            await backend.get_preferences(ctx("alice"))
+        assert (raised.value.status, raised.value.code) == (403, code)
+
+
+async def test_unknown_session_and_unreachable_workspace_fail(workspace):
+    access = access_for(workspace)
+    with pytest.raises(AgentCookieError) as raised:
+        await access.authorize("ghost")
+    assert raised.value.status == 404
+    workspace.unreachable = True
+    with pytest.raises(AgentCookieError) as raised:
+        await access.authorized_fields("alice")
+    assert (raised.value.status, raised.value.code) == (0, "UNREACHABLE")
+
+
+async def test_note_round_trip_is_scoped_by_merchant_and_subject(workspace):
+    notes_a = RelationshipNotes(access_for(workspace, KEY_A), MemoryWriteFilter.build())
+    notes_b = RelationshipNotes(access_for(workspace, KEY_B), MemoryWriteFilter.build())
+    await notes_a.put("alice", fact())
+    back = await notes_a.get("alice", "fit_history")
+    assert back is not None and back.value == "runs half a size small"
+    assert back.category is MemoryCategory.CONTEXT and back.source_session_id == "abc123"
+    assert await notes_a.get("bob", "fit_history") is None
+    assert await notes_b.get("alice", "fit_history") is None
+    put = next(r for r in workspace.requests if r.method == "PUT")
+    assert put.url.params["sessionId"] == "salice01"
+
+
+async def test_filtered_oversized_and_unlisted_notes_never_reach_the_workspace(workspace):
+    notes = RelationshipNotes(access_for(workspace), MemoryWriteFilter.build())
+    with pytest.raises(MemoryWriteRejected):
+        await notes.put("alice", fact(value="mail me at a@example.com"))
+    with pytest.raises(MemoryWriteRejected):
+        await notes.put("alice", fact(value="card 4111111111111111"))
+    with pytest.raises(MemoryWriteRejected):
+        await notes.put("alice", fact(key="shoe_size"))
+    big = fact().model_copy(update={"value": "é" * 200, "source_session_id": "x" * 80})
+    small = RelationshipNotes(access_for(workspace), MemoryWriteFilter.build())
+    encoded = small.encode(big)
+    assert len(encoded.encode()) < 2048  # schema bounds keep one fact under the note limit
+    assert workspace.requests == []
+
+
+async def test_revoked_note_write_is_refused_before_put(workspace):
+    notes = RelationshipNotes(access_for(workspace), MemoryWriteFilter.build())
+    workspace.denied["salice01"] = "GRANT_REVOKED"
+    with pytest.raises(AgentCookieError):
+        await notes.put("alice", fact())
+    assert all(r.method == "GET" for r in workspace.requests)
+
+
+def test_guard_refuses_memory_routes_and_revoked_chat(workspace):
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+
+    from demo_common.agent_cookie import install_agent_cookie_guard
+    from demo_common.sessions import UnknownSessionError
+
+    class Record:
+        user_id = "alice"
+
+    class Sessions:
+        def require(self, session_id):
+            if session_id != "host-1":
+                raise UnknownSessionError(session_id)
+            return Record()
+
+    class Host:
+        sessions = Sessions()
+
+    app = FastAPI()
+    reached: list[str] = []
+
+    @app.post("/api/reset")
+    async def reset(body: dict) -> dict:
+        reached.append("reset")
+        return {"ok": True, "body": body}
+
+    @app.post("/api/chat")
+    async def chat() -> dict:
+        reached.append("chat")
+        return {"ok": True}
+
+    install_agent_cookie_guard(app, Host(), access_for(workspace))
+    client = TestClient(app)
+    assert client.get("/api/memory").status_code == 501
+    assert client.post("/api/reset", json={"purge_memory": True}).status_code == 501
+    assert client.post("/api/reset", json={"clear_memory": True}).status_code == 501
+    plain = client.post("/api/reset", json={})
+    assert plain.status_code == 200 and plain.json()["body"] == {}
+    assert client.post("/api/chat", headers={"X-Session-Id": "host-1"}).status_code == 200
+    workspace.denied["salice01"] = "GRANT_REVOKED"
+    refused = client.post("/api/chat", headers={"X-Session-Id": "host-1"})
+    assert refused.status_code == 403 and refused.json()["detail"]["code"] == "GRANT_REVOKED"
+    assert reached == ["reset", "chat"]
