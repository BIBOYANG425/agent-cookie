{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node --env-file-if-exists=.env --import tsx src/main.ts check",
    "demo": "tsx src/main.ts demo",
    "smoke": "node --env-file-if-exists=.env --import tsx src/main.ts smoke",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts serve"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "2.1.9"
  },
  "name": "@agent-cookie/channel-photon",
  "dependencies": {
    "@agent-cookie/learn": "workspace:^",
    "@agent-cookie/sdk": "workspace:*",
    "@photon-ai/api": "0.5.0",
    "socket.io-client": "4.8.3",
    "spectrum-ts": "12.11.0"
  }
}
